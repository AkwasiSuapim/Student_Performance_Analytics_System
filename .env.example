# Backend (read from the environment; copy to .env and export, or set inline).
# Maximum upload size in megabytes (default 10)
STUDENT_ANALYTICS_MAX_UPLOAD_MB=10
# Origin(s) allowed to call the API from a browser; comma-separated
# (default http://localhost:5173,http://127.0.0.1:5173)
STUDENT_ANALYTICS_FRONTEND_ORIGIN=http://localhost:5173
# Where each analysis' inputs and outputs are stored (default ./analysis_output)
STUDENT_ANALYTICS_OUTPUT_DIR=analysis_output

# Frontend: set these in frontend/.env (see frontend/.env.example)
# VITE_API_BASE_URL=http://localhost:8000

# Alert thresholds (all optional; defaults shown). See README "Performance alerts".
# STUDENT_ANALYTICS_ALERT_CURRENT_GRADE=70
# STUDENT_ANALYTICS_ALERT_CURRENT_GRADE_HIGH=60
# STUDENT_ANALYTICS_ALERT_ATTENDANCE=80
# STUDENT_ANALYTICS_ALERT_ATTENDANCE_HIGH=70
# STUDENT_ANALYTICS_ALERT_PASS_MARK=60
# STUDENT_ANALYTICS_ALERT_MISSING_ASSESSMENTS=2
# STUDENT_ANALYTICS_ALERT_DOWNWARD_TREND_POINTS=10
# STUDENT_ANALYTICS_ALERT_ATTENDANCE_DECLINE_POINTS=15
# STUDENT_ANALYTICS_ALERT_PREDICTION_GAP_POINTS=15
# STUDENT_ANALYTICS_ALERT_TREND_BAND_POINTS=5

# Curated learning-resource catalog (JSON). Default: the packaged sample catalog.
# STUDENT_ANALYTICS_RESOURCE_CATALOG=/path/to/approved_resources.json
